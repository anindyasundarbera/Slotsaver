# ---------------------------------------------------------------------------
# SlotSaver local configuration. Copy to backend/.env and edit.
# NEVER commit real credentials. This POC refuses live payment mode.
# ---------------------------------------------------------------------------

# "simulated" = offline rehearsal (no network, no real money, clearly labelled).
# "sandbox"   = real PayPal Sandbox. Requires the two credentials below.
PAYPAL_MODE=simulated
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=20

# Shared secret for the SIMULATED webhook verifier. Leave blank for a random
# per-process value (recommended). Never commit a real value: a published HMAC
# key would let any client mint a "verified" capture. Required only by tests
# that sign their own events (they set it explicitly).
SIMULATED_WEBHOOK_SECRET=

# "scripted" = deterministic offline assistant. "llm" = OpenAI-compatible endpoint.
ASSISTANT_MODE=scripted
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOOL_ITERATIONS=4

# Storage. SQLite is fine for a local demo; use Postgres for any hosted run.
DATABASE_URL=sqlite:///./data/slotsaver.db

# Business context. DEMO_DATE anchors every seeded date relative to it.
BUSINESS_NAME=Northline Appliance Care
BUSINESS_TZ=America/New_York
DEMO_DATE=2026-11-03
HOLD_TTL_MINUTES=15

# Session/cookie behaviour. Set COOKIE_SECURE=true behind HTTPS.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:4200

# Demo lifecycle controls.
SEED_DEMO_DATA=true
ALLOW_DEMO_RESET=true
ENVIRONMENT=development
