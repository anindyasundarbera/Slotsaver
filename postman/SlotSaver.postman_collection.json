{
  "info": {
    "name": "SlotSaver \u2014 API verification",
    "description": "Repeatable checks for SlotSaver. Covers the happy path plus the negative cases that matter: concurrent holds, duplicate capture, tampered amount, foreign object access, and webhook signature rejection.\n\nRun against a LOCAL instance only. Set `baseUrl` and run `./scripts/reset-demo.sh` first so the fixtures are deterministic.\n\nAuthentication: POST /auth/login returns HttpOnly session + non-HttpOnly `ss_csrf` cookies. Collection-level scripts copy the CSRF value into `csrfToken`; Postman persists cookies automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "holdId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "simulatedOrderId",
      "value": ""
    },
    {
      "key": "foreignBookingId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Capture the CSRF cookie after any request that sets it.",
          "const jar = pm.cookies;",
          "const token = jar.get('ss_csrf');",
          "if (token) { pm.collectionVariables.set('csrfToken', token); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Public",
      "item": [
        {
          "name": "Health is ok",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ok', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "pm.test('reports a provider mode', function () {",
                  "    pm.expect(['simulated', 'sandbox']).to.include(pm.response.json().paypal_mode);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Config exposes no secrets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "config"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('never contains credential material', function () {",
                  "    const raw = pm.response.text().toLowerCase();",
                  "    ['client_secret', 'api_key', 'secret', 'token', 'password'].forEach(function (k) {",
                  "        pm.expect(raw).to.not.include(k);",
                  "    });",
                  "});",
                  "pm.test('publishes the business timezone', function () {",
                  "    pm.expect(pm.response.json().timezone).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Services catalogue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
