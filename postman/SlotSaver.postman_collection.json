        {
          "name": "Cannot hold without CSRF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "holds"
              ]
            },
            "description": "Override: remove the X-CSRF-Token header for this request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_code\": \"washer-repair\",\n  \"technician_id\": \"tech_ana\",\n  \"start_utc\": \"2026-11-04T16:00:00Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Deliberately strip the CSRF header for this request.",
                  "pm.request.headers.remove('X-CSRF-Token');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('blocked without CSRF', function () {",
                  "    pm.expect(pm.response.code).to.eql(403);",
                  "});",
                  "pm.test('mentions CSRF', function () {",
                  "    pm.expect(pm.response.json().error.message).to.include('CSRF');",
                  "});"
                ]
              }
            }
          ]
        },
