              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('has technicians and events', function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.technicians.length).to.be.above(0);",
                  "    pm.expect(b).to.have.property('events');",
                  "});"
                ]
              }
            }
          ]
