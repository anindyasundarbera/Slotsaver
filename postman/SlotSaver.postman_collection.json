    {
      "name": "3 \u00b7 Customer journey",
      "item": [
        {
          "name": "Assistant returns real options",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assistant/message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "message"
              ]
            },
            "description": "The seeded demo request must yield options that satisfy the stated constraints.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I need washing-machine service tomorrow after 4 PM. My budget is $80, and it must finish before 6.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('assistant reported tool activity', function () {",
                  "    pm.expect(pm.response.json().tool_trace.length).to.be.above(0);",
                  "});",
                  "const options = pm.response.json().options || [];",
                  "const hasCapacity = options.length > 0;",
                  "pm.test('has bookable capacity (reset fixtures before running)', function () {",
                  "    pm.expect(hasCapacity, 'no capacity left: run ./scripts/reset-demo.sh and restart the API').to.be.true;",
                  "});",
                  "if (hasCapacity) {",
                  "    pm.test('respects the stated budget', function () {",
                  "        options.forEach(function (o) { pm.expect(o.price_cents).to.be.at.most(8000); });",
                  "    });",
                  "    const first = options[0];",
                  "    pm.collectionVariables.set('optionStartUtc', first.start_utc);",
                  "    pm.collectionVariables.set('optionTech', first.technician_id);",
                  "    pm.collectionVariables.set('optionService', first.service_code);",
                  "} else {",
                  "    // Skip the dependent requests so one precondition failure does not",
                  "    // masquerade as twenty unrelated defects.",
                  "    postman.setNextRequest('Owner routes reject a customer');",
                  "}"
                ]
              }
            }
          ]
        },
