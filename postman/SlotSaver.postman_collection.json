    {
      "name": "2 \u00b7 Auth",
      "item": [
        {
          "name": "Login as customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maya@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Login is rate-limited (10/min/IP). Repeated collection runs inside",
                  "// one minute will hit it. Report that once and stop: every later",
                  "// assertion would be meaningless.",
                  "if (pm.response.code === 429) {",
                  "    pm.test('login rate limited - wait 60s or restart the API, then rerun', function () {",
                  "        pm.expect(pm.response.code, 'rate limiter engaged; this is the control working').to.eql(200);",
                  "    });",
                  "    postman.setNextRequest(null);",
                  "    return;",
                  "}",
                  "pm.test('signed in', function () { pm.response.to.have.status(200); });",
                  "pm.test('role is customer', function () {",
                  "    pm.expect(pm.response.json().role).to.eql('customer');",
                  "});",
                  "pm.test('csrf cookie captured', function () {",
                  "    pm.expect(pm.collectionVariables.get('csrfToken')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown account is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
