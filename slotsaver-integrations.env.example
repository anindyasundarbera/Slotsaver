# SlotSaver integration configuration proposal — 25 October 2026
# No credentials are included. Do not overwrite an existing populated .env.
# Map these names into the actual repository's settings loader; retain working names.
# Except noted SDK/example conventions, these are project-proposed names.
# Blank optional values are intentional. Enable only selected/implemented adapters.
# Angular does NOT read this file automatically. Expose only public allowlisted config.
# Runtime-injected Astropods/Render values are NOT user-supplied keys in this template.

# ---- Existing app / storage (project names; adapt rather than duplicate) ----
# Preserve the existing durable database URL/driver and stable session secret.
DATABASE_URL=
APP_SESSION_SECRET=
PUBLIC_APP_ORIGIN=http://localhost:4200
# Readiness and provider checks must not echo this file or secret values.

# ---- Required payment layer: PayPal SANDBOX only ----
# PROJECT names, explicitly mapped by the backend. Not universal PayPal SDK env names.
PAYMENTS_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Client ID may be deliberately exposed for browser SDK; secret stays backend-only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Non-secret intended seller ID; obtain from actual sandbox seller/app, never guess.
PAYPAL_EXPECTED_MERCHANT_ID=
PAYPAL_CURRENCY=USD
# Redirect-flow examples; retain current SDK-button navigation if already working.
PAYPAL_RETURN_URL=http://localhost:4200/checkout/return
PAYPAL_CANCEL_URL=http://localhost:4200/checkout/cancel
PAYPAL_HTTP_TIMEOUT_SECONDS=15
# Optional until actual registered webhook intake is implemented and verified.
PAYPAL_WEBHOOKS_ENABLED=false
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=
# Do not store OAuth access tokens, sandbox buyer passwords or real card data here.

# ---- Bryntum: core timeline; licence/package setup is separate ----
SLOTSAVER_ENABLE_BRYNTUM=true
# No verified universal BRYNTUM_LICENSE_KEY setting. Follow purchased/trial setup.
# The coding agent must install compatible core/wrapper packages and check demo rights.

# ---- AG Studio: optional operator analytics ----
SLOTSAVER_ENABLE_AG_STUDIO=false
SLOTSAVER_ENABLE_STUDIO_AI=false
# PROJECT setting passed explicitly to browser licence manager; not an API auth key.
AG_STUDIO_LICENSE_KEY=
# Only needed if the Studio backend adapter does not reuse an existing model adapter.
# PROJECT aliases: preserve existing provider vars instead when already configured.
STUDIO_LLM_PROVIDER=
STUDIO_LLM_MODEL=
STUDIO_LLM_BASE_URL=
STUDIO_LLM_API_KEY=
# Model key is backend-only; never copy it into Angular/public config.

# ---- APIMatic: development-time PayPal Context Plugin ----
# No runtime APIMATIC_API_KEY required for the pre-enabled PayPal plugin.
# Install/configure in the actual coding assistant environment; reload it as documented.

# ---- Assistant runtime: retain existing implementation by default ----
SLOTSAVER_AGENT_RUNTIME=existing
SLOTSAVER_ENABLE_ASTROPODS=false
# PROJECT locators for a selected Astropods adapter, not automatic vendor env names.
SLOTSAVER_ASTROPODS_API_BASE_URL=https://astropods.com
SLOTSAVER_ASTROPODS_DEPLOYMENT_ID=
# Optional agent->existing backend tool connection; implement actual scoped auth first.
SLOTSAVER_BACKEND_BASE_URL=
SLOTSAVER_BACKEND_SERVICE_TOKEN=
# Do NOT paste CLI/user session tokens into this template as a production auth solution.
# ASTRO_GATEWAY_URL / ASTRO_GATEWAY_API_KEY / MODEL_DEFAULT are injected in agent runtime.
# They do not authenticate calls from SlotSaver to Astropods deployed-agent chat.
# Unattended external chat auth must be resolved before switching away from existing runtime.

# ---- Channel3: optional real product discovery ----
SLOTSAVER_ENABLE_CHANNEL3=false
# Documentation-example name; adapter explicitly maps it to x-api-key.
CHANNEL3_API_KEY=
# API URL and locale policy come from reviewed adapter/config; no retailer payment implied.

# ---- Elastic: optional policy retrieval ----
SLOTSAVER_ENABLE_ELASTIC=false
# PROJECT names; use Elasticsearch endpoint, NOT Kibana or Cloud management URL.
ELASTICSEARCH_URL=
# Encoded index-scoped read API key, not an Elastic Cloud control-plane key.
ELASTICSEARCH_API_KEY=
ELASTIC_INDEX=slotsaver-policies-v1
# Setup/ingestion-only key, not for the ordinary request-serving runtime.
# Prefer keeping this in an operator-only secret context rather than deploying it.
ELASTIC_INGEST_API_KEY=

# ---- KERNEL: optional connected browser smoke / necessary legacy portal ----
SLOTSAVER_BROWSER_SMOKE_ENABLED=false
SLOTSAVER_BROWSER_SMOKE_BASE_URL=
# VENDOR SDK-recognized environment variable; server/job only.
KERNEL_API_KEY=

# ---- Postman: development/CI only ----
# PROJECT shell secret reference, not guaranteed automatic CLI env lookup.
# Optional when the chosen CLI flow needs API-key login; prefer existing auth setup.
POSTMAN_API_KEY=
# Do not place public/shared collection environment secrets here for frontend consumption.
# Generate ignored private Postman environment data from the existing config if required.

# ---- Render: hosting / optional background Workflows ----
# RENDER_API_KEY is needed only for selected management/API/Workflows automation.
# Merely hosting the application does NOT require this key in the app runtime.
RENDER_API_KEY=
# PROJECT variable containing the actual registered task slug; do not invent an ID.
RENDER_TASK_SLUG=
# Set hosted app secrets in Render separately; a local .env is not uploaded automatically.
# PORT and RENDER_* service metadata are host-managed, not keys to copy from this file.
# DATABASE_URL must use persistent storage in hosting; free local files are ephemeral.

# ---- Zapier: optional approved cross-app action ----
SLOTSAVER_ENABLE_ZAPIER=false
# VENDOR example name; backend explicitly sends Authorization: Bearer <token>.
ZAPIER_MCP_TOKEN=
# PROJECT allowlist entry; fill only after discovering the actual configured action/schema.
ZAPIER_ALLOWED_TOOL=
# Constant verified transport endpoint: https://mcp.zapier.com/api/v1/connect
# Create MCP server and app OAuth connections in Zapier; a token alone cannot do that.
